// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  pending
  cash_pending
  paid
}

enum PaymentRecordStatus {
  pending
  completed
}

enum TaskStatus {
  open
  in_progress
  done
}

// Was mit einem erkannten Zahlungseingang passiert ist.
enum NoticeStatus {
  // Liegt zur Durchsicht — steht noch in keiner Kasse.
  neu
  // Wurde zu einem Beitrag gemacht.
  uebernommen
  // Bewusst weggeklickt: keine Spende, sondern etwas anderes.
  ignoriert
}

enum RequestStatus {
  open
  answered
}

// Woher eine Änderung kam. Im Admin sitzt eine angemeldete Person, über den
// Chat schreibt OpenClaw im Auftrag einer Person aus der Telegram-Gruppe.
enum AuditSource {
  admin
  chat
  system
}

// Nur die drei Felder, die das Anmeldeformular erhebt. Telefon und Allergien
// wurden entfernt, als das Formular verschlankt wurde — sie ließen sich nicht
// mehr befüllen und hatten keinen Verwendungszweck.
model Guest {
  id            String        @id @default(cuid())
  name          String
  // Eindeutig, damit die Doppelanmeldungs-Prüfung nicht nur im Code steht:
  // zwei gleichzeitige Anmeldungen mit derselben Adresse würden die reine
  // Lesen-dann-Schreiben-Prüfung sonst beide passieren.
  email         String        @unique
  plusOnes      Int           @default(0)
  paymentStatus PaymentStatus @default(pending)
  waitlisted    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  payments      Payment[]
}

model Payment {
  id            String               @id @default(cuid())
  guest         Guest                @relation(fields: [guestId], references: [id])
  guestId       String
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("EUR")
  // Beide Felder stammen aus der Zeit mit der PayPal-REST-API und werden nicht
  // mehr geschrieben: Spenden laufen jetzt über einen PayPal.me-Link, von dem
  // die App nichts mitbekommt. Die Spalten bleiben, damit die Belege der
  // damaligen Buchungen erhalten bleiben.
  paypalOrderId String?              @unique
  paypalCaptureId String?
  status        PaymentRecordStatus  @default(pending)
  createdAt     DateTime             @default(now())
  completedAt   DateTime?
  // Gesetzt, wenn der Beitrag aus einer Benachrichtigungsmail übernommen wurde
  // statt von Hand eingetippt zu werden.
  notice        PaymentNotice?
}

// Ein Zahlungseingang, den die App in einer PayPal-Benachrichtigungsmail
// gefunden hat.
//
// Ausdrücklich kein Beleg und keine Buchung: Die Zeile hier ist ein Vorschlag,
// den die Orga ansieht und entweder übernimmt oder wegklickt. Erst beim
// Übernehmen entsteht ein Payment. Der Grund ist der Weg, auf dem die Angaben
// entstanden sind — aus dem Fließtext einer E-Mail geraten, nicht von PayPal
// bestätigt. Eine gefälschte Absenderadresse ist schnell geschrieben; deshalb
// darf aus dieser Zeile nie von selbst Geld im Kassenstand werden.
model PaymentNotice {
  id String @id @default(cuid())

  // Der Message-ID-Header der Mail. Eindeutig, damit ein zweiter Abruf
  // dieselben Mails nicht ein zweites Mal in die Liste legt. Die IMAP-Nummer
  // taugt dafür nicht — die vergibt der Server neu, wenn das Postfach
  // aufgeräumt wird.
  messageId String @unique

  receivedAt DateTime
  // In Cent, damit zwischen Mail und Kasse nichts gerundet wird. Null heißt:
  // Im Text stand kein eindeutiger Betrag, die Orga muss ihn eintippen.
  amountCents     Int?
  currency        String  @default("EUR")
  senderName      String?
  senderEmail     String?
  transactionCode String?
  // Der Betreff, damit im Zweifel nachvollziehbar ist, woher die Zeile kommt.
  subject String

  // Hat Google die DKIM-Signatur von PayPal bestätigt? Ohne das ist die Mail
  // nicht mehr als eine Behauptung über ihren Absender.
  dkimVerified Boolean @default(false)

  status NoticeStatus @default(neu)

  // Gesetzt, sobald daraus ein Beitrag geworden ist.
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, receivedAt])
}

model BudgetCategory {
  id        String   @id @default(cuid())
  // Eindeutig: Der Plan-Import und die Chat-Werkzeuge erkennen Kategorien am
  // Namen. Ohne Constraint legen zwei gleichzeitige Zugriffe zwei Kategorien
  // gleichen Namens an, und danach ist nicht mehr klar, welche gemeint ist.
  name      String   @unique
  sortOrder Int      @default(0)
  tasks     Task[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Member[]
  tasks     Task[]
}

model Member {
  id        String   @id @default(cuid())
  name      String
  // Optional: Wer über den Chat jemanden zur Orga hinzufügt, hat dessen Nummer
  // selten zur Hand. Ohne Nummer geht alles außer Einzelnachricht und
  // get_my_tasks — das melden die betroffenen Stellen namentlich, statt
  // stillschweigend niemanden zu erreichen.
  phone     String?
  createdAt DateTime @default(now())
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId    String?
  tasks     Task[]
}

model Task {
  id             String         @id @default(cuid())
  category       BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  title          String
  // Der Titel ist die Kennung und bleibt kurz. Was jemand sonst noch wissen
  // muss — Maße, Ansprechpartner, wo das Zeug steht — gehört hierher, damit
  // der Titel nicht zum Absatz wird.
  description    String?
  // Ein Foto sagt bei „welcher Anhänger?" mehr als drei Sätze. Die Datei liegt
  // im Blob-Speicher, und der ist privat: Ausgeliefert wird sie nur über eine
  // Route, die vorher die Admin-Sitzung prüft. Deshalb steht hier der Pfad im
  // Speicher und keine öffentlich abrufbare URL.
  imagePath      String?
  status         TaskStatus     @default(open)
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId       String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId         String?
  estimatedCost  Decimal?       @db.Decimal(10, 2)
  actualCost     Decimal?       @db.Decimal(10, 2)
  dueDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Gleicher Grund wie bei der Kategorie: Import und Chat erkennen Aufgaben am
  // Titel innerhalb ihrer Kategorie.
  @@unique([categoryId, title])
}

// Wer hat was wann geändert. Bei fünf Leuten, die parallel im Admin und über
// die Telegram-Gruppe pflegen, ist das der einzige Weg herauszufinden, warum
// ein Eintrag plötzlich anders aussieht.
//
// Bei source = chat ist `actor` das, was OpenClaw als Urheber meldet — ein
// Protokoll, keine Zugangskontrolle. Die Zugangskontrolle ist der MCP-Token.
model AuditEntry {
  id        String      @id @default(cuid())
  at        DateTime    @default(now())
  source    AuditSource
  actor     String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime    @default(now())

  @@index([at])
}

model Request {
  id         String        @id @default(cuid())
  name       String
  email      String
  message    String
  status     RequestStatus @default(open)
  createdAt  DateTime      @default(now())
  answeredAt DateTime?
}

// Termin, Name und Line-up-Hinweis der Veranstaltung. Genau eine Zeile mit
// fester Kennung: Es gibt ein Fest, nicht viele. Fehlt die Zeile, greifen die
// Vorgaben aus lib/event.ts — die Einladung steht also auch vor dem ersten
// Speichern im Admin.
//
// Beginn und Ende liegen bewusst als echte Zeitpunkte vor und nicht als Text:
// Aus einem Satz wie "ab 13 Uhr" lässt sich kein Kalendereintrag bauen.
// Ein Programmpunkt: wer spielt wann und wo.
//
// Bewusst nicht nur „Line-up": Auf denselben Zeitstrahl gehören auch Aufbau,
// Anlieferung und Abbau. Die unterscheiden sich vom Line-up nur darin, dass
// sie niemanden außerhalb der Orga etwas angehen — dafür ist `isPublic` da,
// nicht ein zweites Modell.
model TimetableSlot {
  id    String @id @default(cuid())
  title String
  // Freitext statt Aufzählung: Welche Areas es gibt, entscheidet sich beim
  // Aufbau und nicht beim Deploy. Das Formular schlägt die schon benutzten
  // Namen vor, damit daraus nicht „DJ-Area" neben „DJ Area" wird.
  stage String

  startsAt DateTime
  // Optional: Beim letzten Act der Nacht weiß niemand, wann Schluss ist.
  endsAt   DateTime?
  note     String?

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Zwei Acts zur selben Zeit auf derselben Bühne sind keine Planung, sondern
  // ein Versehen. Gleicher Grund wie bei Kategorie und Aufgabe: Der Bot
  // erkennt einen Programmpunkt an Bühne und Beginn wieder, und ohne
  // Constraint legen zwei gleichzeitige Zugriffe ihn doppelt an.
  @@unique([stage, startsAt])
  @@index([startsAt])
}

model EventInfo {
  id         String    @id
  name       String
  startsAt   DateTime?
  endsAt     DateTime?
  lineupNote String?
  updatedAt  DateTime  @updatedAt
}
