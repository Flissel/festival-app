# Postgres-Verbindung (z. B. Neon/Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/festival"

# Admin-Login
# Hash erzeugen: npm run admin:hash -- "dein-passwort"
ADMIN_PASSWORD_HASH=""
# Beliebiger langer Zufallswert, signiert die Session-Cookies
# Erzeugen: openssl rand -hex 32
SESSION_SECRET=""

# PayPal (https://developer.paypal.com)
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
# Sandbox: https://api-m.sandbox.paypal.com — Live: https://api-m.paypal.com
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# ID des in der PayPal-Konsole angelegten Webhooks (Event: PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=""

# Gmail-Versand (App-Passwort unter https://myaccount.google.com/apppasswords)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# OpenClaw-Gateway für WhatsApp-Benachrichtigungen (optional)
OPENCLAW_GATEWAY_URL=""
OPENCLAW_GATEWAY_TOKEN=""

# Bearer-Token für den MCP-Server unter /api/mcp (optional)
MCP_SERVER_TOKEN=""

# Maximale Gesamt-Gästezahl inkl. Begleitpersonen (optional, leer = unbegrenzt).
# Bei Erreichen landen neue Anmeldungen auf der Warteliste.
RSVP_CAPACITY=""

# Öffentliche Basis-URL der App ohne Slash am Ende, z. B. https://festival.example.com
# Wird für Zahlungslinks in E-Mails gebraucht; leer = Mails ohne Zahlungslink.
APP_BASE_URL=""
