# Postgres-Verbindung (z. B. Neon/Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/festival"

# Admin-Login
# Hash erzeugen: npm run admin:hash -- "dein-passwort"
ADMIN_PASSWORD_HASH=""
# Beliebiger langer Zufallswert, signiert die Session-Cookies
# Erzeugen: openssl rand -hex 32
SESSION_SECRET=""

# Spenden laufen über einen PayPal.me-Link — kein Geschäftskonto, keine
# Gebühren bei "Freunde und Familie". Die App bekommt von der Zahlung nichts
# mit; Eingänge trägt die Orga im Admin unter Gäste von Hand ein.
# Das Kürzel steht als Vorgabe in lib/donation.ts; diese Variable überschreibt
# es nur, falls das Geld woanders hin soll. Kürzel oder ganze URL, beides geht.
# Eigenen Link anlegen: https://www.paypal.com/paypalme/grab
PAYPAL_ME_URL=""

# Bankverbindung für alle, die lieber überweisen (optional).
DONATION_IBAN=""
DONATION_IBAN_HOLDER=""

# Gmail (App-Passwort unter https://myaccount.google.com/apppasswords)
# Dieselben Zugangsdaten für zweierlei:
#  1. Versand der Bestätigungs- und Antwortmails (SMTP).
#  2. Lesen der PayPal-Benachrichtigungen unter /admin/spenden (IMAP). Dafür
#     muss in den Gmail-Einstellungen unter „Weiterleitung und POP/IMAP" der
#     IMAP-Zugriff eingeschaltet sein — für den Versand allein genügt er nicht.
# Ohne diese Werte bleibt die Spendenliste reine Handarbeit.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# OpenClaw-Gateway für Benachrichtigungen und Broadcast (optional).
# Ohne diese Werte geht keine Nachricht raus — der Broadcast sagt das dann auch.
OPENCLAW_GATEWAY_URL=""
OPENCLAW_GATEWAY_TOKEN=""
# Kanalname für Nachrichten an die Gruppe. Standard: telegram
OPENCLAW_CHANNEL="telegram"
# Kanal für Einzelnachrichten. Ziel ist dort eine Telefonnummer, und die
# versteht nur WhatsApp — Telegram kennt als Ziel nur Chat-IDs.
OPENCLAW_PHONE_CHANNEL="whatsapp"
# Chat-ID der Orga-Gruppe. Nur damit kann der Broadcast eine Nachricht an die
# Gruppe statt einzeln an jedes Member schicken.
TELEGRAM_GROUP_CHAT_ID=""

# Bearer-Token für den MCP-Server unter /api/mcp. Darüber greift OpenClaw auf
# Aufgaben, Budget und Gästezahlen zu — ohne Token ist der Endpunkt deaktiviert.
# Der Token ist die einzige Zugangskontrolle: Wer ihn hat, darf alles, was die
# Werkzeuge können. Erzeugen z. B. mit: openssl rand -hex 32
MCP_SERVER_TOKEN=""

# Schmaler Token nur für den Foto-Upload (/api/mcp/task-image), optional.
# Der Bot lädt Fotos aus einer Sandbox hoch, die keinen Zugriff auf seine
# Konfiguration hat — der Token muss ihr also mitgegeben werden. Damit ein
# mitgegebener Token so wenig wie möglich kann, gilt dieser hier nur für den
# Upload und nicht für die übrigen Werkzeuge. Bleibt er leer, gilt weiterhin
# MCP_SERVER_TOKEN auch für den Upload.
MCP_UPLOAD_TOKEN=""

# Speicher für die Fotos an Aufgaben (Vercel Blob). Wird beim Verbinden des
# Blob-Speichers automatisch gesetzt. Fehlt der Token, funktioniert alles
# andere weiter — nur der Foto-Upload meldet, dass er nicht eingerichtet ist.
# Der Speicher ist privat: Ausgeliefert werden Fotos nur über eine Route, die
# vorher die Admin-Sitzung prüft.
BLOB_READ_WRITE_TOKEN=""

# Maximale Gesamt-Gästezahl inkl. Begleitpersonen (optional, leer = unbegrenzt).
# Bei Erreichen landen neue Anmeldungen auf der Warteliste.
RSVP_CAPACITY=""

# Öffentliche Basis-URL der App ohne Slash am Ende, z. B. https://festival.example.com
# Wird für Zahlungslinks in E-Mails gebraucht; leer = Mails ohne Zahlungslink.
APP_BASE_URL=""
